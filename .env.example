# ==============================================================================
# Environment Configuration for Manuscript HTR and Research Assistant
# ==============================================================================

# Application General
APP_NAME="Makhtootat HTR & Research Platform"
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
SECRET_KEY=change-this-in-production-use-a-strong-secret-key-at-least-32-chars

# Database & pgvector
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/makhtootat_db
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/makhtootat_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=makhtootat_db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# JWT Authentication
JWT_SECRET_KEY=jwt-secret-key-change-in-production-very-secure-random-bytes
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Storage Configuration
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,tiff,tif

# S3 / MinIO Configuration (Optional for cloud storage)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=manuscripts
S3_REGION=us-east-1

# HTR / OCR Configuration
OCR_DEFAULT_MODEL=trocr_handwritten_persian
OCR_MODEL_PATH=./models/htr_checkpoints
OCR_DEVICE=cpu
OCR_BATCH_SIZE=8
OCR_MAX_LENGTH=256
OCR_CONFIDENCE_THRESHOLD=0.65
ENABLE_IMAGE_PREPROCESSING=True
ENABLE_LINE_SEGMENTATION=True

# Multilingual Embeddings Configuration
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
EMBEDDING_DIMENSION=768
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
VECTOR_SEARCH_ENABLED=True
SEMANTIC_SEARCH_ENABLED=True

# Text Chunking Settings
CHUNK_SIZE_WORDS=80
CHUNK_OVERLAP_WORDS=15

# LLM / RAG Assistant Configuration
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_BASE_URL=
LLM_TIMEOUT=30
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TEMPERATURE=0.2

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
